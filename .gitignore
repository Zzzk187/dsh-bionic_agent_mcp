*.zip
dist/

# OS / editor
.DS_Store
Thumbs.db

# Windows reserved device name "nul" appears as a phantom entry in this dir
# (like /dev/null); it is NOT a real file and git cannot index it — exclude it.
nul
data/panel-boot.log
data/panel-client.log
